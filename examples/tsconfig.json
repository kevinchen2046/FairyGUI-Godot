{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "godot": ["gen/godot/index.d.ts"],
      "godot/*": ["gen/godot/*"]
    },
    "rootDir": "./ts/Scripts",
    "outDir": "./ts/Generated"
  },
  "include": [
    "ts/**/*.ts"
  ]
}
