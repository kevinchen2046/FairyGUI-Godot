{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "noEmit": false,
    "esModuleInterop": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": ".godot/.tsbuildinfo",
    "rootDir": ".",
    "outDir": ".godot/GodotJS",
    "sourceRoot": "../../../",
    "newLine": "crlf",
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "typeRoots": ["./typings"],
    "paths": {
      "godot": ["typings/godot.mix.d.ts"]
    }
  },
  "include": [
    "ts/Scripts/**/*.ts",
    "typings/godot.mix.d.ts",
    "typings/godot*.gen.d.ts"
  ],
  "exclude": [
    "ts/Generated/**"
  ]
}
