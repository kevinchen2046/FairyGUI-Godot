		<member name="grayed" type="bool" setter="setGrayed" getter="isGrayed"></member>
		<member name="flippedH" type="bool" setter="setFlippedH" getter="isFlippedH"></member>
		<member name="flippedV" type="bool" setter="setFlippedV" getter="isFlippedV"></member>
		<member name="color" type="Color" setter="setColor" getter="getColor">精灵的颜色调制。</member>
		<member name="region" type="Rect2" setter="setRegion" getter="getRegion"></member>
		<member name="regionEnabled" type="bool" setter="setRegionEnabled" getter="isRegionEnabled"></member>
		<member name="texture" type="Object" setter="setTexture" getter="getTexture">精灵的纹理资源。</member>
		<member name="fillMethod" type="int" setter="setFillMethod" getter="getFillMethod">填充方式。</member>
		<member name="fillOrigin" type="int" setter="setFillOrigin" getter="getFillOrigin">填充起点。</member>
		<member name="fillClockwise" type="bool" setter="setFillClockwise" getter="isFillClockwise">填充是否顺时针。</member>
		<member name="fillAmount" type="float" setter="setFillAmount" getter="getFillAmount">填充量。</member>
	</members>
	<signals>
	</signals>
