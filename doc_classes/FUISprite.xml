		<constant name="FillMethod_None" value="0"></constant>
		<constant name="FillMethod_Horizontal" value="0"></constant>
		<constant name="FillMethod_Vertical" value="0"></constant>
		<constant name="FillMethod_Radial90" value="0"></constant>
		<constant name="FillMethod_Radial180" value="0"></constant>
