			<return type="void" />
			<description>清除当前显示内容</description>
		</method>
		<method name="setScale9Grid">
			<return type="void" />
			<param index="0" name="rect" type="Variant" />
			<description>设置九宫格缩放区域</description>
		</method>
		<method name="setScaleByTile">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置是否使用平铺模式缩放</description>
		</method>
		<method name="isScaleByTile">
			<return type="Variant" />
			<description>是否使用平铺模式缩放</description>
		</method>
		<method name="setGrayed">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置为灰度显示</description>
		</method>
		<method name="isGrayed">
			<return type="Variant" />
			<description>是否为灰度显示</description>
		</method>
		<method name="setFlippedH">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置水平翻转</description>
		</method>
		<method name="isFlippedH">
			<return type="Variant" />
			<description>是否水平翻转</description>
		</method>
		<method name="setFlippedV">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置垂直翻转</description>
		</method>
		<method name="isFlippedV">
			<return type="Variant" />
			<description>是否垂直翻转</description>
		</method>
		<method name="setColor">
			<return type="void" />
			<param index="0" name="color" type="Variant" />
			<description>设置色调颜色</description>
		</method>
		<method name="getColor">
			<return type="Variant" />
			<description>获取色调颜色</description>
		</method>
		<method name="setRegion">
			<return type="void" />
			<param index="0" name="rect" type="Variant" />
			<description>设置纹理区域</description>
		</method>
		<method name="getRegion">
			<return type="Variant" />
			<description>获取纹理区域</description>
		</method>
		<method name="setRegionEnabled">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置是否启用纹理区域</description>
		</method>
		<method name="isRegionEnabled">
			<return type="Variant" />
			<description>是否启用纹理区域</description>
		</method>
		<method name="setTexture">
			<return type="void" />
			<param index="0" name="texture" type="Variant" />
			<description>设置纹理</description>
		</method>
		<method name="getTexture">
			<return type="Variant" />
			<description>获取纹理</description>
		</method>
		<method name="setFillMethod">
			<return type="void" />
			<param index="0" name="method" type="Variant" />
			<description>设置填充方法</description>
		</method>
		<method name="getFillMethod">
			<return type="Variant" />
			<description>获取填充方法（水平/垂直/径向等）</description>
		</method>
		<method name="setFillOrigin">
			<return type="void" />
			<param index="0" name="origin" type="Variant" />
