		</method>
		<method name="setFillAmount">
			<return type="void" />
			<param index="0" name="amount" type="Variant" />
			<description>设置填充量 (0~1)</description>
		</method>
		<method name="getFillAmount">
			<return type="Variant" />
			<description>获取填充量 (0~1)</description>
		</method>
