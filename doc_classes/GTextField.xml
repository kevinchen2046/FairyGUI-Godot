		</method>
		<method name="isUBBEnabled">
			<return type="Variant" />
			<description>是否启用 UBB 语法解析。</description>
		</method>
		<method name="setTemplateVars">
			<return type="void" />
			<param index="0" name="vars" type="Variant" />
			<description>设置模板变量表。</description>
		</method>
		<method name="getTextSize">
			<return type="Variant" />
			<description>获取渲染后的文本尺寸。</description>
		</method>
