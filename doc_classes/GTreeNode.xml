<?xml version="1.0" encoding="UTF-8" ?>
<class name="GTreeNode" inherits="RefCounted" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>FairyGUI 中的树节点。</brief_description>
	<description>GTreeNode 表示 GTree 中的一个节点。支持设置是否为文件夹（isFolder）、展开状态（expanded）、节点文本（text）和图标（icon）。通过 parent、children 管理层次关系。</description>
	<methods>
		<method name="setText">
			<return type="void" />
			<param index="0" name="text" type="Variant" />
			<description>设置节点文本</description>
		</method>
		<method name="getText">
			<return type="Variant" />
			<description>获取节点文本</description>
		</method>
		<method name="setIcon">
			<return type="void" />
			<param index="0" name="icon" type="Variant" />
			<description>设置节点图标</description>
		</method>
		<method name="getIcon">
			<return type="Variant" />
			<description>获取节点图标</description>
		</method>
		<method name="isFolder">
			<return type="Variant" />
			<description>是否为文件夹节点</description>
		</method>
		<method name="isExpanded">
			<return type="Variant" />
			<description>是否已展开</description>
		</method>
		<method name="setExpanded">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description></description>
		</method>
		<method name="getParent">
			<return type="Variant" />
			<description>获取父节点</description>
		</method>
		<method name="getTree">
			<return type="Variant" />
			<description>获取所属的树</description>
		</method>
		<method name="getCell">
			<return type="Variant" />
			<description>获取节点关联的 UI 组件（Cell）</description>
		</method>
		<method name="getData">
			<return type="Variant" />
			<description>获取节点数据（用户自定义数据）</description>
		</method>
		<method name="setData">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置节点数据</description>
		</method>
		<method name="getChildAt">
			<return type="Variant" />
			<param index="0" name="index" type="Variant" />
			<description>获取指定位置的子节点</description>
		</method>
		<method name="numChildren">
			<return type="void" />
			<description>获取子节点数量</description>
		</method>
		<method name="addChild">
			<return type="void" />
			<param index="0" name="child" type="Variant" />
			<description>添加子节点（添加到末尾）</description>
		</method>
		<method name="init">
			<return type="void" />
			<param index="0" name="is_folder" type="Variant" />
			<param index="1" name="res_url" type="Variant" />
			<description></description>
		</method>
	</methods>
	<members>
	</members>
	<signals>
	</signals>
	<constants>
	</constants>
</class>
