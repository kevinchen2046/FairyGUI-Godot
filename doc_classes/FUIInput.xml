	<members>
		<member name="maxLength" type="int" setter="setMaxLength" getter="getMaxLength"></member>
		<member name="password" type="bool" setter="setPassword" getter="isPassword"></member>
		<member name="singleLine" type="bool" setter="setSingleLine" getter="isSingleLine"></member>
		<member name="editable" type="bool" setter="setEditable" getter="isEditable"></member>
