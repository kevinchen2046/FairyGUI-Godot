			<return type="void" />
			<param index="0" name="text" type="Variant" />
			<description>设置输入文本</description>
		</method>
		<method name="getText">
			<return type="Variant" />
			<description>获取输入文本</description>
		</method>
		<method name="setMaxLength">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置最大输入长度</description>
		</method>
		<method name="getMaxLength">
			<return type="Variant" />
			<description>获取最大输入长度</description>
		</method>
		<method name="setPassword">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置是否为密码输入</description>
		</method>
		<method name="isPassword">
			<return type="Variant" />
			<description>是否为密码输入</description>
		</method>
		<method name="setSingleLine">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置是否为单行输入</description>
		</method>
		<method name="isSingleLine">
			<return type="Variant" />
			<description>是否为单行输入</description>
		</method>
		<method name="setEditable">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置是否可编辑</description>
		</method>
		<method name="isEditable">
			<return type="Variant" />
			<description>是否可编辑</description>
		</method>
		<method name="setInputRestrict">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置输入限制正则表达式</description>
		</method>
		<method name="getInputRestrict">
			<return type="Variant" />
			<description>获取输入限制正则表达式</description>
		</method>
		<method name="setPlaceholder">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description></description>
		</method>
		<method name="setPlaceholderColor">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置占位文本颜色</description>
		</method>
		<method name="setPlaceholderFontSize">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置占位文本字体大小</description>
		</method>
		<method name="setKeyboardType">
			<return type="void" />
			<param index="0" name="value" type="Variant" />
			<description>设置键盘类型</description>
		</method>
		<method name="getKeyboardType">
			<return type="Variant" />
			<description>获取键盘类型</description>
		</method>
		<method name="openKeyboard">
			<return type="void" />
			<description>打开系统键盘</description>
		</method>
		<method name="applyTextFormat">
			<return type="void" />
			<description>应用文本格式</description>
		</method>
